# Core required (local minimum)
DATABASE_URL=XXX
# DDL owner connection, only used by prisma:migrate; schema must be dorapocket.
# Runtime DATABASE_URL must use the restricted dorapocket_app role.
MIGRATION_DATABASE_URL=XXX
# Keep the total across all running app instances below the database pool limit.
DATABASE_POOL_MAX=5
NEXT_PUBLIC_SUPABASE_URL=XXX
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=XXX
SUPABASE_SECRET_KEY=XXX
QWEN_API_KEY=XXX
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_EMBEDDING_DIMENSIONS=1024
TOOL_VECTOR_RECALL_ENABLED=true

# Optional voice features
ALIYUN_AK_ID=XXX
ALIYUN_AK_SECRET=XXX
ALIYUN_NLS_APPKEY=XXX

# Cron + Supabase Database Webhook (shared Bearer secret)
CRON_SECRET=XXX

# Migration-only target settings belong in ignored .env.migration.local.
# Keep the source settings in .env until cutover.
# TARGET_DATABASE_URL=postgresql://.../postgres?schema=dorapocket
# TARGET_SUPABASE_URL=https://tfvzcuksahcofooqqezx.supabase.co
# TARGET_SUPABASE_PUBLISHABLE_KEY=...
# TARGET_SUPABASE_SECRET_KEY=...
# TARGET_AUTH_USER_ID=...
# TARGET_RUNTIME_DATABASE_PASSWORD=...
