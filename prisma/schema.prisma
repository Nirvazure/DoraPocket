generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["dorapocket"]
}

model User {
  id                        String                     @id @default(cuid())
  supabaseUserId            String                     @unique
  email                     String?
  nickname                  String
  avatarSrc                 String?
  bio                       String?
  website                   String?
  company                   String?
  authCreatedAt             DateTime?
  lastSignInAt              DateTime?
  authRole                  String?
  authProvider              String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  settings                  UserSettings?
  pocketItems               PocketItem[]
  marketFeedback            MarketFeedback[]
  marketSubmissions         MarketSubmission[]
  toolActivities            ToolActivity[]
  chatHistory               ChatHistoryEntry[]
  preferenceOverride        PreferenceProfileOverride?
  recommendationSessions    RecommendationSession[]
  recommendationEvaluations RecommendationEvaluation[]
  createdTools              Tool[]

  @@schema("dorapocket")
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  voicePlaybackEnabled Boolean  @default(true)
  voicePlaybackMode    String   @default("key-result")
  soundEffectsEnabled  Boolean  @default(true)
  defaultInputMode     String   @default("text")
  memoryEnabled        Boolean  @default(true)
  explanationMode      String   @default("standard")
  fontPreset           String   @default("c")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("dorapocket")
}

model Tool {
  id              String           @id
  name            String
  url             String
  description     String
  category        String
  tags            String[]
  iconUrl         String?
  status          String           @default("active")
  pricingModel    String           @default("unknown")
  requiresAuth    Boolean?
  platform        String           @default("unknown")
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  index           ToolIndex?
  pocketItems     PocketItem[]
  marketFeedback  MarketFeedback[]
  toolActivities  ToolActivity[]

  @@schema("dorapocket")
}

model ToolIndex {
  toolId         String                       @id
  content        String
  contentHash    String
  searchDocument Unsupported("tsvector")?     @default(dbgenerated())
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?
  embeddedAt     DateTime?
  tool           Tool                         @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@schema("dorapocket")
}

model PocketItem {
  id             String   @id @default(cuid())
  userId         String
  toolId         String
  savedAt        DateTime @default(now())
  lastUsedAt     DateTime @default(now())
  useCount       Int      @default(0)
  pinned         Boolean  @default(false)
  purchased      Boolean  @default(false)
  archived       Boolean  @default(false)
  sourceQuestion String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool           Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@schema("dorapocket")
}

model MarketFeedback {
  id           String   @id @default(cuid())
  userId       String
  toolId       String
  vote         String
  starRating   Int
  selectedTags String[]
  updatedAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool         Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@schema("dorapocket")
}

model MarketSubmission {
  id                  String    @id @default(cuid())
  userId              String
  toolId              String?
  name                String
  url                 String
  description         String
  tags                String[]
  submittedAt         DateTime  @default(now())
  status              String    @default("review")
  dedupCheckedAt      DateTime?
  duplicateSimilarity Float?
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("dorapocket")
}

model ToolActivity {
  id     String @id @default(cuid())
  userId String
  toolId String
  saves  Int    @default(0)
  opens  Int    @default(0)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool   Tool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@schema("dorapocket")
}

model ChatHistoryEntry {
  id             String   @id @default(cuid())
  userId         String
  userText       String
  assistantText  String
  selectedToolId String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("dorapocket")
}

model PreferenceProfileOverride {
  id                  String   @id @default(cuid())
  userId              String   @unique
  preferredCategories String[]
  preferredTags       String[]
  preferredPlatforms  String[]
  preferredPricing    String[]
  avoidAuthWall       Boolean?
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("dorapocket")
}

model RecommendationSession {
  id                String                     @id @default(cuid())
  userId            String
  userText          String
  taskFrame         Json
  selectedToolId    String?
  candidates        Json
  selectionReason   String
  selectionSignals  String[]
  preferenceSignals String[]
  finalText         String
  starterPath       String?
  clarifyTurnCount  Int                        @default(0)
  confidenceLevel   String?
  openedToolId      String?
  savedToolId       String?
  evaluatedAt       DateTime?
  createdAt         DateTime                   @default(now())
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluations       RecommendationEvaluation[]

  @@schema("dorapocket")
}

model RecommendationEvaluation {
  id                      String                @id @default(cuid())
  userId                  String
  recommendationSessionId String
  selectedToolId          String?
  opened                  Boolean               @default(false)
  saved                   Boolean               @default(false)
  tried                   Boolean               @default(false)
  helpful                 Boolean?
  outcome                 String?
  rating                  Int?
  tags                    String[]
  comment                 String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationSession   RecommendationSession @relation(fields: [recommendationSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationSessionId])
  @@schema("dorapocket")
}
